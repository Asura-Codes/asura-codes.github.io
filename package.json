{
  "name": "asura-codes-github-io",
  "version": "0.0.1",
  "description": "Asura Codes portfolio",
  "productName": "Asura Codes",
  "author": "Patryk Tomaszewski <patryk.tomaszewski@iase.wroc.pl>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build -m ssg",
    "postinstall": "quasar prepare",
    "deploy": "node -e \"require('fs').cpSync('CNAME', 'dist/ssg/CNAME')\" && cd dist && gh-pages -d ssg"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.1",
    "gapi-script": "^1.2.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^3.10.4",
    "@types/node": "^26.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite-plugin-checker": "^1.0.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
